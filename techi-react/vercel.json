{
  "rewrites": [
    { "source": "/wp-json/:path*", "destination": "https://techi-eg.com/wp-json/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/techi-assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
