{
  "name": "rfaheya-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --open",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:headless": "vite --mode headless",
    "start:headless": "vite build --mode headless && vite preview --open",
    "build:headless": "tsc -b && vite build --mode headless",
    "release": "npm run export:content && npm run build:headless && node scripts/package-release.mjs",
    "export:content": "vite build --mode export --ssr scripts/export-content.ts && node .export-content/export-content.js",
    "build:preview": "VITE_HASH_ROUTER=1 vite build --base ./ --outDir dist-preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
