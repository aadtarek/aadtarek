# Rfaheya: headless WordPress + React storefront in the same public_html.
#
# public_html/
#   .htaccess                        <- this file
#   index.html  assets/  import/ …   <- the storefront (contents of dist.zip)
#   index.php  wp-admin/  wp-content/  wp-includes/ …   <- WordPress
#
# Storefront pages (/, /shop, /product/…, /checkout, …) are served by
# index.html. WordPress keeps wp-admin, the REST API (/wp-json), My Account
# and payment pages. To keep another WordPress path (e.g. a blog), add it
# to the "WordPress pages" rule.

# index.php first so folders like wp-admin/ open WordPress; the home page
# is sent to the storefront by an explicit rule below.
DirectoryIndex index.php index.html

# BEGIN Rfaheya
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# WordPress admin & files (the dashboard explicitly, some servers pick the
# wrong folder index otherwise)
RewriteRule ^wp-admin/?$ wp-admin/index.php [L]
RewriteRule ^wp-admin - [L]
RewriteRule ^wp-content - [L]
RewriteRule ^wp-includes - [L]
RewriteRule ^wp-login\.php - [L]
RewriteRule ^wp-cron\.php - [L]
RewriteRule ^xmlrpc\.php - [L]

# REST API -> WordPress (the storefront reads products and the cart from here)
RewriteRule ^wp-json/(.*)$ index.php?rest_route=/$1 [QSA,L]
RewriteRule ^wp-json/?$ index.php?rest_route=/ [QSA,L]

# WordPress pages: My Account, payment pages, gateway callbacks, sitemap, feed
RewriteRule ^(my-account|checkout/order-pay|wc-api|wp-sitemap|feed)(/|\.|$) index.php [L]
# WordPress links by query string (?p=, ?preview=, ?wc-ajax=, ?rest_route=, …)
RewriteCond %{QUERY_STRING} (^|&)(rest_route|wc-api|wc-ajax|preview|p|page_id|post_type|s|customize_changeset_uuid)= [NC]
RewriteRule ^ index.php [L]

# Home page -> storefront page shell, served by WordPress with the shop data
# (and the page's main image) already inside, for a fast first view.
RewriteRule ^$ index.php?rfaheya_shell=1 [QSA,L]

# Existing files (React assets, product images, …)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Other storefront pages: the same page shell with the shop data inside
RewriteRule ^ index.php?rfaheya_shell=1 [QSA,L]
</IfModule>

# Always fetch a fresh page shell, so a new upload shows up straight away.
# Storefront files in /assets have the content hash in their name, so they
# can be cached for a year; images and videos for a month.
<IfModule mod_headers.c>
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|webp|avif|png|jpe?g|svg|mp4)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/avif "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compress text responses (the storefront's JavaScript, CSS and JSON).
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
# END Rfaheya
